# ═══════════════════════════════════════════════════════════
# ReconBase — Variables de entorno
# Copia este archivo a .env en local, o configura en Railway.
# ═══════════════════════════════════════════════════════════

# ── OBLIGATORIAS EN PRODUCCIÓN ──
SECRET_KEY=cambia_esto_por_una_cadena_aleatoria_larga
DATABASE_URL=postgresql://user:pass@host:5432/dbname
BASE_URL=https://tudominio.com

# ── STRIPE (ReconBase ya es gratuito) ──
# Solo hace falta mientras queden suscripciones antiguas por cancelar: el perfil
# usa el portal de Stripe y la baja de cuenta cancela la suscripción si existe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── EMAIL ──
# Opción A: Resend (recomendado, vía HTTPS API)
RESEND_API_KEY=re_...
# Opción B: SMTP (Gmail como fallback). Usa una app-password, no tu contraseña.
MAIL_USER=tu_email@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=ReconBase <noreply@tudominio.com>

# ── OPCIONALES ──
# Email de contacto público (aviso legal, privacidad, security.txt, emails y PDF).
# Vacío = no se muestra ninguno. Obligatorio en el aviso legal (LSSI art. 10): créalo y rellénalo.
CONTACT_EMAIL=
# Sentry para tracking de errores
SENTRY_DSN=
# Clave de Have I Been Pwned (consulta de filtraciones)
RECONBASE_API_KEY=
# Google Web Risk (herramienta de listas negras). Sin clave, la herramienta sale como no disponible.
WEB_RISK_API_KEY=
# Turnstile de Cloudflare (registro y formulario de informe por email)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Clave para seudonimizar las IP de los visitantes (por defecto se deriva de SECRET_KEY)
IP_HASH_SECRET=
# Listas DNSBL para la reputación de IPs (solo listas que permitan uso comercial)
DNSBL_LISTAS=bl.spamcop.net
# Analytics
GA_ID=
PLAUSIBLE_DOMAIN=
# Rate limit por visitante real (ver /admin/origen-check)
# ORIGIN_SECRET: mismo valor que la cabecera X-Origin-Secret que añade la Transform Rule de Cloudflare
ORIGIN_SECRET=
# ORIGIN_LOCK=1 rechaza el acceso directo al origen (*.up.railway.app). Activar solo tras verificar.
ORIGIN_LOCK=
# Contadores del rate limit compartidos entre workers y persistentes entre despliegues
REDIS_URL=
